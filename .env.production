# Production Environment Configuration
# Used by systemd services for RunThru

# Frontend Configuration
FRONTEND_PORT=13000
NEXT_TELEMETRY_DISABLED=1
BACKEND_URL=http://localhost:14000

# Backend API Configuration (for backend service)
PORT=14000
NODE_ENV=production

# Database (relative to backend directory)
DATABASE_PATH=./database/runthru.db

# TTS Service
TTS_SERVICE_URL=http://localhost:5000

# OpenAI (for script analysis and character portraits)
OPENAI_API_KEY=no_key_here

# Authentication
PIN_CODE=1234
ACCESS_PIN=7374849

# File Storage (relative to backend directory)
AUDIO_CACHE_DIR=./data/audio-cache
SCRIPTS_DIR=./data/scripts
PORTRAITS_DIR=./public/portraits

# Logging
LOG_LEVEL=INFO
